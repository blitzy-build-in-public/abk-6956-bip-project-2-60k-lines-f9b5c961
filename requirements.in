# Runtime dependency pins for qrcheck: this file is the compile input for requirements.lock.
# Regenerate with: pip-compile --generate-hashes --output-file=requirements.lock requirements.in
# The lock is the only authority for transitive versions: never hand-edit it, and always
# install it with --require-hashes so the whole hashed closure is verified.
# pip-tools 7.5.3 must be run under pip==24.0, because later pip releases removed
# pip._internal.utils.compat.stdlib_pkgs, which pip-tools imports.
click==8.1.8  # CLI structure, option validation, CliRunner test harness
httpx==0.27.2  # HTTP target adapter: explicit timeouts, connection reuse, loopback client
numpy==1.26.4  # seeded PCG64 generator and array ops for damage synthesis and measurement
opencv-python-headless==4.10.0.84  # secondary reference decoder, OpenCV detector; headless, no GUI libs
Pillow==10.4.0  # image IO, grid sampling, resize/rotate/warp/blur/JPEG/noise, PNG encode
segno==1.6.6  # golden encoder used strictly as the expectation oracle
zxing-cpp==2.2.0  # primary decoder: payload bytes, EC level, content type, corner position
# zxing-cpp publishes no cp311 wheel for Linux aarch64, where qrcheck doctor blocks with
# exit 2 naming the missing distribution. That is a runtime check, so no environment
# marker and no fallback decoder are declared here.
# The transitive closure (anyio, certifi, h11, httpcore, idna, sniffio, typing-extensions)
# is deliberately absent: pip-compile derives it, and --require-hashes needs all of it
# hashed, so the lock alone owns those versions.
