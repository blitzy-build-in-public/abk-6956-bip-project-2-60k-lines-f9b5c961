# Development-only tooling (test runner, coverage gates, lock regeneration).
# It pins the runtime set too (via -r requirements.in) so this lock is a superset
# that installs on its own with --require-hashes and cannot disagree with
# requirements.lock about a shared transitive pin (pip-tools pulls click).
# Regenerate with: pip-compile --generate-hashes --allow-unsafe \
#                     --output-file=requirements-dev.lock requirements-dev.in
# pip-tools 7.5.3 requires pip==24.0 in the generation environment (see requirements.in).
-r requirements.in
pytest==8.2.2
pytest-cov==5.0.0
coverage==7.6.1
pip-tools==7.5.3
